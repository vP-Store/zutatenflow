{
  "name": "cockpit",
  "productName": "Cockpit",
  "version": "1.0.0",
  "description": "Eigene Startoberfläche für Windows: Apps, Dateien und Internet an einem Ort.",
  "main": "src/main/main.js",
  "author": "vP-Store",
  "license": "UNLICENSED",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/vP-Store/zutatenflow.git"
  },
  "scripts": {
    "start": "electron .",
    "check": "node scripts/check.js",
    "test": "node --test test/unit.test.js",
    "e2e": "node test/e2e.js",
    "dist": "electron-builder --win nsis --publish never"
  },
  "dependencies": {
    "electron-updater": "6.8.9",
    "koffi": "3.3.2"
  },
  "devDependencies": {
    "electron": "44.5.0",
    "electron-builder": "26.15.3",
    "playwright-core": "1.63.0"
  },
  "build": {
    "appId": "de.vpstore.cockpit",
    "productName": "Cockpit",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Cockpit",
      "artifactName": "Cockpit-Setup.exe",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true
    },
    "asar": false,
    "publish": [
      {
        "provider": "github",
        "owner": "vP-Store",
        "repo": "zutatenflow",
        "releaseType": "release"
      }
    ]
  }
}
